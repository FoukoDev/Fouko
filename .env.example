# Copy this file to .env and fill in whatever platforms / services you want.
# The bot picks up every token that is set and silently skips the rest.
# .env is gitignored, .env.example is the template that ships with the repo.
#
# Quoting rules (a bad line stops the whole file from loading past it):
#   spaces in a value        -> double quotes:  KEY="two words"
#   $ or \ in a value        -> single quotes:  KEY='pa$$w\ord'
#   plain tokens/ids/urls    -> no quotes needed

# --- Platforms ---------------------------------------------------------------

# Telegram: get one from @BotFather
TG_TOKEN=

# Discord: create an application, then Bot -> Reset Token
DISCORD_TOKEN=

# --- Storage -----------------------------------------------------------------
# Storage backend URL. If you leave this empty, FoukoApi creates a SQLite
# file next to this .env (foukoapi.sqlite) on first launch. Supported:
#   sqlite:/path/to/file.db       local SQLite file (auto-created)
#   memory:                       in-memory, lost on restart
#   postgres://user:pass@host/db  external driver (bring your own Storage impl)
# FOUKO_DB=sqlite:./foukobot.sqlite

# --- Owner -------------------------------------------------------------------
# Where the bot DMs operational alerts (crash restarts, update floods).
# Leave both ids empty to disable owner alerts entirely.

# Your Telegram user id. Run /profile in a chat with the bot and check
# the Account section to find it.
OWNER_TG_ID=

# Your Discord user id.
OWNER_DISCORD_ID=

# Preferred alert platform: telegram | discord. If empty, telegram is
# preferred; when the chosen platform is unavailable the bot falls back
# to the other one (if its id is set).
OWNER_ALERT_PLATFORM=

# Send a flood alert when the bot sees more than this many updates in a
# single minute. Defaults to 300.
# FLOOD_ALERT_PER_MIN=300

# --- Services ----------------------------------------------------------------

# Encryption passphrase for the /ai feature. Everything the AI feature
# stores (hosts, API keys, system prompts, chat history) is encrypted with a
# key derived from this. Pick a long random string and keep it safe - losing
# it makes the stored AI data unreadable. Leave empty to disable /ai.
# If it contains $ or \, wrap it in single quotes (see the top of this file).
FOUKO_SECRET=

# --- Webapp ------------------------------------------------------------------
# Telegram Mini App: a web UI for the whole /ai feature, served by the bot.
# Public https URL of the app behind a reverse proxy (nginx, caddy...).
# Requires TG_TOKEN and FOUKO_SECRET. Leave empty to disable the web app.
WEBAPP_URL=

# No domain? Set this to "cloudflared" and the bot spins up a free
# Cloudflare quick tunnel (https://<random>.trycloudflare.com) on start and
# uses it as WEBAPP_URL. Needs the cloudflared binary installed. The URL is
# random and changes on every restart; for a stable URL get a domain and
# set WEBAPP_URL instead. Ignored when WEBAPP_URL is set.
# WEBAPP_TUNNEL=cloudflared

# Address the webapp server listens on. Put your reverse proxy in front of
# it; don't expose this port directly. Defaults to 127.0.0.1:8990.
# WEBAPP_BIND=127.0.0.1:8990

# --- Presence ------------------------------------------------------------------
# What the bot appears to be doing on Discord (member list + profile).
# Telegram has no presence concept and ignores all of this.
# PRESENCE_KIND: playing | streaming | listening | watching | competing | custom
#   custom is the free-form status line under the bot's name, no
#   "Playing" prefix - good for a joke ("/help me please").
# PRESENCE_TEXT: the activity name / status text; empty = no presence.
#                Quote values with spaces: PRESENCE_TEXT="two words".
# PRESENCE_URL:  click-through link, streaming only. The purple LIVE dot
#                only lights up for twitch.tv/youtube.com links; other
#                https URLs keep the green dot but still show the line.
# PRESENCE_STATE: the smaller detail line under the activity name on the
#                profile card (streaming and friends; ignored by custom).
# PRESENCE_STATUS: online | idle | dnd | invisible (default online).
# PRESENCE_KIND=streaming
# PRESENCE_TEXT="/help me please"
# PRESENCE_URL=https://www.twitch.tv/yourchannel
# PRESENCE_STATE=https://bot.fouko.xyz
# PRESENCE_STATUS=online

# --- Logging -----------------------------------------------------------------
# Log verbosity filter (tracing syntax). When unset the bot defaults to
# info,serenity=warn,tracing=warn (serenity's connection chatter hidden,
# warnings still shown). Setting RUST_LOG overrides that entirely.
# RUST_LOG=debug

# Directory for rotating log files (a new file per day). Defaults to ./logs.
# The bot also logs to stdout regardless of this setting.
# FOUKO_LOG_DIR=logs
