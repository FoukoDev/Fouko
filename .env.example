# Copy this file to .env and fill in whatever platforms / services you want.
# The bot picks up every token that is set and silently skips the rest.
# .env is gitignored, .env.example is the template that ships with the repo.

# --- Platforms ---------------------------------------------------------------

# Telegram: get one from @BotFather
TG_TOKEN=

# Discord: create an application, then Bot -> Reset Token
DISCORD_TOKEN=

# --- Storage -----------------------------------------------------------------
# Storage backend URL. If you leave this empty, FoukoApi creates a SQLite
# file next to the binary (foukoapi.sqlite) on first launch. Supported:
#   sqlite:/path/to/file.db       local SQLite file (auto-created)
#   memory:                       in-memory, lost on restart
#   postgres://user:pass@host/db  external driver (bring your own Storage impl)
# FOUKO_DB=sqlite:./foukobot.sqlite

# --- Owner -------------------------------------------------------------------
# Where the bot DMs operational alerts (crash restarts, update floods).
# Leave both ids empty to disable owner alerts entirely.

# Your Telegram user id. Run /profile in a chat with the bot and check
# the Account section to find it.
OWNER_TG_ID=

# Your Discord user id.
OWNER_DISCORD_ID=

# Preferred alert platform: telegram | discord. If empty, telegram is
# preferred; when the chosen platform is unavailable the bot falls back
# to the other one (if its id is set).
OWNER_ALERT_PLATFORM=

# Send a flood alert when the bot sees more than this many updates in a
# single minute. Defaults to 300.
# FLOOD_ALERT_PER_MIN=300

# --- Services ----------------------------------------------------------------

# Encryption passphrase for the /ai feature. Everything the AI feature
# stores (hosts, API keys, system prompts, chat history) is encrypted with a
# key derived from this. Pick a long random string and keep it safe - losing
# it makes the stored AI data unreadable. Leave empty to disable /ai.
FOUKO_SECRET=

# --- Logging -----------------------------------------------------------------
# Log verbosity filter (tracing syntax). When unset the bot defaults to
# info,serenity=warn,tracing=warn (serenity's connection chatter hidden,
# warnings still shown). Setting RUST_LOG overrides that entirely.
# RUST_LOG=debug

# Directory for rotating log files (a new file per day). Defaults to ./logs.
# The bot also logs to stdout regardless of this setting.
# FOUKO_LOG_DIR=logs
